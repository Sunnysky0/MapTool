{
  "name": "maptool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run compile:check && tsc -b && vite build",
    "preview": "vite preview",
    "compile:source": "tsx scripts/compile-source-map.ts",
    "compile:check": "tsx scripts/compile-source-map.ts --check",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@react-three/drei": "latest",
    "@react-three/fiber": "latest",
    "@resvg/resvg-js": "2.6.2",
    "d3-geo": "latest",
    "d3-geo-projection": "latest",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "react": "latest",
    "react-dom": "latest",
    "three": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/css-tree": "latest",
    "@types/d3-geo": "latest",
    "@types/node": "latest",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest",
    "@vitejs/plugin-react": "latest",
    "@xmldom/xmldom": "latest",
    "css-tree": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "svg-pathdata": "latest",
    "transformation-matrix": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
